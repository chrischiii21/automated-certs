# Copy to .env.local and fill in.

# Public URL of the site, used in verification emails, the sitemap and social previews.
# On Vercel it falls back to the production domain automatically.
APP_URL=http://localhost:3000

# Long random string that signs login cookies. Required in production; changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# The account that takes over events created before accounts existed (when it signs in with this email).
ADMIN_EMAIL=

# Gmail SMTP for email-verification and password-reset emails. Use an App Password, not your normal password:
# Google Account → Security → 2-Step Verification → App passwords.
# Without these in development, verification and reset links are printed in the server console instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Turso — `turso db show <db> --url` and `turso db tokens create <db>`
# Leave TURSO_DATABASE_URL empty in development to use a local SQLite file (local.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (template images) — Vercel dashboard → Storage → Blob → .env.local tab
BLOB_READ_WRITE_TOKEN=

# Optional: enables "Auto-style" in the design editor. Free key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# Only for the one-time `bun run migrate:supabase`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
